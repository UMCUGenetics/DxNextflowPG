/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    UMCUGenetics/DxNextflowPG Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

manifest {
    name            = 'UMCUGenetics/DxNextflowPG'
    author          = """UMCU Genetics"""
    homePage        = 'https://github.com/UMCUGenetics/DxNextflowPG'
    description     = """UMCU Genetics PGx Workflow"""
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.0.0' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

// Nextflow settings
nextflow {
	   enable {
	      moduleBinaries = true
	   }
	}

// Global default params, used in configs
params {
    genome_fasta = '/hpc/diaggen/data/databases/ref_genomes/Homo_sapiens.GRCh38.GCA_000001405.15/full_plus_hs38d1_analysis_set/GCA_000001405.15_GRCh38_full_plus_hs38d1_analysis_set.fna'
    genome_dict  = '/hpc/diaggen/data/databases/ref_genomes/Homo_sapiens.GRCh38.GCA_000001405.15/full_plus_hs38d1_analysis_set/GCA_000001405.15_GRCh38_full_plus_hs38d1_analysis_set.dict'
    dbsnp = '/hpc/diaggen/data/databases/GATK_resource_bundle/hg38/dbsnp_146.hg38.vcf.gz'


    variant_DP_threshold = 15 // todo op runtime instellen op sequence cov/2
    // Input options
    bam_path = null // Input bam files for the analysis
    /*
        Pypgx default parameters
    */
    // see: https://pypgx.readthedocs.io/en/latest/genes.html
    pgx_genes = ["CYP2B6", "CYP2C19", "CYP2D6", "UGT1A1"]
    pypgx_control_gene = "VDR"
    pypgx_resource_bundle = '/hpc/diaggen/data/databases/PyPGx_resource_bundle/pypgx-bundle-0.25.0'
    assembly_version = "GRCh38"

    // Star allele calling from in-house excel sheel
    phenotypes_excel = "/hpc/diaggen/users/joris/pypgx/dec2022_translation_table.xlsx"

    // Output options
    outdir           = null
    publish_dir_mode = 'link'
    email            = null

    cluster_options = "--mail-user $params.email --mail-type FAIL --account=diaggen"

    // test_data = "/hpc/diaggen/users/joris/test_data/"

}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Load base.config
includeConfig 'conf/base.config'

// Load modules.config for module specific options
includeConfig 'conf/modules.config'

report {
    enabled = true
    file = "$params.outdir/log/nextflow_report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "$params.outdir/log/nextflow_trace.txt"
    overwrite = true
}

timeline {
    enabled = true
    file = "$params.outdir/log/nextflow_timeline.html"
    overwrite = true
}

docker.registry      = 'quay.io'
singularity.registry = 'quay.io'
apptainer.registry   = 'quay.io'


profiles {

    slurm {
        process {
            executor = 'slurm'
            queue = 'cpu'
            clusterOptions = "$params.cluster_options"

            errorStrategy = 'retry'
            maxRetries = 0
        }

        apptainer.enabled = false
        singularity {
            enabled = true
            runOptions = '-B /hpc:/hpc -B $TMPDIR:$TMPDIR'
            autoMounts = true
            cacheDir = '/hpc/diaggen/software/singularity_cache/'
        }

        executor {
            queueSize = 1000
            pollInterval = '1min'
            queueStatInterval = '5min'
            submitRatelimit = '10sec'
        }

       mail {
            smtp.host = 'localhost'
        }
    }

    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g) '
    }

    singularity {
        singularity.enabled = true
        docker.enabled= false
        runOptions = '-B /hpc:/hpc -B $TMPDIR:$TMPDIR'
        autoMounts = true
        cacheDir = '/hpc/diaggen/software/singularity_cache/'
    }

    test {
        singularity.enagled = true
        docker.enabled = false
        runOptions = '-B /hpc:/hpc -B $TMPDIR:$TMPDIR'
        autoMounts = true
        cacheDir = '/hpc/diaggen/software/singularity_cache/'
        // includeConfig 'tests/nextflow.config'
    }
}
