nextflow_process {
    name "Test combine results pypgx"

    tag "local"
    tag "module"
    tag "combine"
    tag "utils"


    config 'tests/nextflow.config'
    script "modules/local/combine_outputs/main.nf"
    process "COMBINERESULTS"

    test("combine outputs pypgx") {

        setup {
            run("UNTAR") {
                script "../modules/nf-core/untar/main.nf"
                process {
                    """
                    input[0] = [
                    [id: 'pipelineout'],
                        file("https://github.com/UMCUGenetics/DxNextflowTestData/raw/refs/heads/main/DxNextflowPG/ngspipelineout.tar.gz")
                    ]
                    """
                }
            }
        }
        when {
            process {
                """

                input[0] = Channel.fromList([
                    tuple(
                        "CYP2D6",
                        [
                    file( [UNTAR.out.untar[1], '/NA19917_subset_0_66cov_CYP2D6_pypgx_output"], checkIfExists: true),
                    file( [UNTAR.out.untar[1], '/NA20509_subset_0_66cov_CYP2D6_pypgx_output"], checkIfExists: true),
                        ]
                    )
                ])
                """
            }
        }
        then {
            assert process.success
            assert snapshot(process.out.bed, process.out.versions).match()

        }

    }

