nextflow_process {
    name "Test combine results pypgx"

    tag "local"
    tag "module"
    tag "combine"
    tag "utils"


    config 'tests/nextflow.config'
    script "modules/local/combine_outputs/main.nf"
    process "COMBINERESULTS"

    test("Test combine outputs pypgx") {
        when {
            process {
                """

                input[0] = Channel.fromList([
                    tuple(
                        "CYP2D6",
                        [projectDir + "/tests/test_data/phenotype_results/HG00436_subset_CYP2D6_pypgx_output/"]
                    )
                ])
                """
            }
        }
        then {
            assert process.success
            assert snapshot(process.out.bed, process.out.versions).match()

        }

    }
}
