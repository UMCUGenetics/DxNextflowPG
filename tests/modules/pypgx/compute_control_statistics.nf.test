nextflow_process {
    name "Test compute control statistics"
    tag "pypgx"
    config '../../nextflow.config'
    script "modules/local/pypgx/compute_control_statistics/main.nf"
    process "PYPGX_COMPUTECONTROLSTATISTICS"

    test("Control statistics") {
        when {
            process {
                """
                input[0] = Channel.fromList([
                tuple([id: 'HG00436_subset'],
                    file(params.test_data + "/HG00436_subset.bam", checkIfExists: true),
                    file(params.test_data + "/HG00436_subset.bam.bai",checkIfExists: true) )
                ])
                """
            }
        }
        then {
            assert process.success
            assert snapshot(process.out.control_stats, process.out.versions).match()

        }

    }
}
