nextflow_process {
    name "Test compute control statistics"
    tag "pypgx"
    config '../../nextflow.config'
    script "modules/local/pypgx/compute_control_statistics/main.nf"
    process "PYPGX_COMPUTECONTROLSTATISTICS"

    test("Control statistics") {
        when {
            process {
                """
                input[0] = Channel.fromList([
                tuple([id: 'HG00436_subset'],
                    file(params.test_data + "/HG00436_subset.bam", checkIfExists: true),
                    file(params.test_data + "/HG00436_subset.bam.bai",checkIfExists: true) )
                ])
                """
            }
        }
        then {
            def zipFile = path(process.out.control_stats[0][1]).zip
            def paths = zipFile.extractAll()
            def metaFile = paths[0]
            def dataFile = paths[1]

            assert process.success
            assert zipFile.isValid()
            


            assert snapshot(
                metaFile.text,
                dataFile.text).match()




            // assert path(filename).zip.getNumberOfFiles() == 2
            // assert snapshot(path(filename).zip.extract("*/metadata.txt")).match()
        }

    }
}
