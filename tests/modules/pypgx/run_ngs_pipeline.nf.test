nextflow_process {
    name "PyPGx NGS pipeline test"
    tag "pypgx"
    config '../../nextflow.config'
    script "modules/local/pypgx/run_ngs_pipeline/main.nf"
    process "PYPGX_RUNNGSPIPELINE"

    test("PyPGx NGS pipeline test") {
        when {
            process {
                """
                input[0] = Channel.fromList([
                tuple([id: 'HG00436_subset'],
                    file(params.test_data + "/ngs_pipeline_test/HG00436_pypgx_variants.vcf.gz", checkIfExists: true),
                    file(params.test_data + "/ngs_pipeline_test/HG00436_pypgx_variants.vcf.gz.tbi", checkIfExists: true),
                    file(params.test_data + "/ngs_pipeline_test/HG00436_subset_coverage.zip", checkIfExists: true),
                    file(params.test_data + "/ngs_pipeline_test/HG00436_subset_control_stats.zip", checkIfExists: true),
                    "CYP2D6"
                )
                ])

                input[1] = Channel.fromList([
                    params.test_data + "/pypgx-bundle-0.25.0/"
            ])
                """
            }
        }
        then {
            assert process.success
            // Matching the snapshot does not make sense for this function, as pypgx creates a zip file with a random directory in it.
            // The md5sum will therefore be different each time.
        }

    }
}
