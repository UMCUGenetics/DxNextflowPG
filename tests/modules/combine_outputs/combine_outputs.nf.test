nextflow_process {
    name "Test combine results pypgx & excel"
    tag "combine"
    tag "utils"
    config 'tests/nextflow.config'
    script "modules/local/combine_outputs/main.nf"
    process "COMBINERESULTS"

    test("Test combine outputs pypgx & excel") {
        when {
            process {
                """

                input[0] = Channel.fromList([
                tuple(
                    "CYP2D6",
                    [params.test_data + "phenotype_results/HG00436_subset_CYP2D6_pypgx_output/"],
                    [file(params.test_data + "phenotype_results/HG00436_subset_CYP2D6_alleles.csv")]
            )
                ])
                
                """
            }
        }
        then {
            assert process.success
            assert snapshot(process.out.bed, process.out.versions).match()

        }

    }
}
