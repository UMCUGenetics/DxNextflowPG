nextflow_function {

    name "Test Utils Functions"
    script "modules/local/utils/fastq.nf"

    tag "local"
    tag "function"
    tag "mapping"
	

    test("Test Function flowcellLaneFromFastq") {
        function "flowcellLaneFromFastq"

        when {
            function {
                """
                input[0] = file( "${projectDir}/tests/DxNextflowTestData/DxNextflowPG/fastq/NA19147_CYP2D6_L001_R1_001.fastq.gz", checkIfExists: true )
                """
            }
        }
        then {
            assert function.success
            assert snapshot(function.result).match()
        }
    }

    test("Test Function extractFastqPairFromDir") {
        function "extractFastqPairFromDir"

        when{
            function {
                """
                input[0] = "${projectDir}/tests/DxNextflowTestData/DxNextflowPG/fastq/"
                input[1] = "analysisX2/outdirtest"
                """
            }
        }
        then{
            assert function.success // It is not possible to test a shapshot result of a function that returns a channel
        }
    }
}
