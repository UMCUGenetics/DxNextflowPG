

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Limit resources so that this can run on GitHub Actions
    max_cpus   = 4
    max_memory = '6.5GB'
    max_time   = '2.h'


    // test_data = "/Users/jsteenbr/test_data/"
    test_data = "${baseDir}/tests/test_data/"
    bam_path = "${test_data}/bam/"

    genome_fasta = "${test_data}/genome.fa"

    pgx_genes = ["CYP2D6"]
    pypgx_resource_bundle = "${baseDir}/assets/pypgx-bundle-0.25.0"
    assembly_version = "GRCh37"

    outdir = '/tmp/output'



}

process {


    withName: PYPGX_CREATEINPUTVCF {
        ext.prefix = {"${meta.id}_variants"}
    }
    withName: PYPGX_CREATEREGIONS {
        ext.assembly_version = {params.assembly_version}
        ext.pgx_genes =  {params.pgx_genes}
        ext.args = {}
    }

    withName: PYPGX_RUNNGSPIPELINE {
        ext.assembly_version = {params.assembly_version}
    }


    withName: BCFTOOLS_VIEW {
        cpus = 1
        memory = {4.GB * task.attempt}
        time = {10.m * task.attempt}

        ext.args = { "--output-type v"}
    }


    withName: FILTER_PYPGX_VCF {
         cpus = 1
         memory = {4.GB * task.attempt}
         time = {10.m * task.attempt}

         ext.args = {
         "-e 'DP<${params.variant_DP_threshold}' --output-type z --write-index=tbi" }
     }

    withName: PYPGX_PREPAREDEPTHOFCOVERAGE {
        cpus = 2
        memory = { 10.GB * task.attempt }
        time = { 5.m  * task.attempt }

        ext.assembly_version = {params.assembly_version}
        ext.pgx_genes =  {params.pgx_genes}
    }

    withName: PYPGX_COMPUTECONTROLSTATISTICS {
        cpus = 2
        memory = { 10.GB * task.attempt }
        time = { 5.m  * task.attempt }


        ext.assembly_version = {params.assembly_version}
        ext.control_gene = {params.pypgx_control_gene}
    }

    withName: PYPGX_RUNNGSPIPELINE {
        cpus = 2
        memory = { 5.GB * task.attempt }
        time = { 10.m  * task.attempt }

        // containerOptions = { "-B ${params.pypgx_allele_table}:/usr/local/lib/python3.12/site-packages/pypgx/api/data/allele-table.csv -B ${params.pypgx_variant_table}:/usr/local/lib/python3.12/site-packages/pypgx/api/data/variant-table.csv"}

        ext.assembly_version = {params.assembly_version}


    }

    withName: SV_QA {
        cpus = 1
        memory = 5.GB
        time = { 5.m * task.attempt }

    }

    // withName: COMBINERESULTS {
         // runOptions = "--mount type=bind,source=/Users/jsteenbr/tools/DxNextflowPG,target=/Users/jsteenbr/tools/DxNextflowPG"
    // }

}
