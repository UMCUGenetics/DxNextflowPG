params {
    // reference files
    genome = "/hpc/diaggen/data/databases/ref_genomes/Homo_sapiens.GRCh38.GCA_000001405.15/GCA_000001405.15_GRCh38_full_plus_hs38d1_analysis_set.fa.gz"
    dbsnp = "/hpc/diaggen/data/databases/GATK_resource_bundle/hg38/dbsnp_138.hg38.vcf.gz"

    intervals_of_interest = "${baseDir}/references/sites_of_interest_GRCh38.interval_list"
    translation_table = "${baseDir}/references/sites_of_interest_GRCh38.yaml"

    iaap_path = "/hpc/diaggen/software/tools/iaap-cli-linux-x64-1.1.0-sha.80d7e5b3d9c1fdfc2e99b472a90652fd3848bbc7/iaap-cli/iaap-cli"
    bafregress_path = "/hpc/diaggen/software/tools/bafregress_0_9_3/"
    gtctovcf_path = "/hpc/diaggen/software/tools/GTCtoVCF-1.2.1/"
    
    // array product files
    bead_pool_manifest_file = "/hpc/diaggen/data/databases/GSA_references/GSA-24v3-0-A2-product_files/GSA-24v3-0_A2.bpm"
    bead_pool_manifest_file_csv = "/hpc/diaggen/data/databases/GSA_references/GSA-24v3-0-A2-product_files/GSA-24v3-0_A2.csv"
    cluster_file = "/hpc/diaggen/data/databases/GSA_references/GSA-24v3-0-A1-product_files/GSA-24v3-0_A1_ClusterFile.egt"
    gender_estimate_file = "/hpc/diaggen/data/databases/GSA_references/GSA-24v1-0_A1_genderest.egt"

    // array support files
    maf_file = "/hpc/diaggen/data/databases/GSA_references/GSA-24v3-0-A1-support_files/GSA-24v3-0_A1_PopulationReport_MAF.txt"
    
    // Extended manifest, generated by using PICARD CreateExtendedIlluminaManifest
    extended_chip_manifest_file = "/hpc/diaggen/data/databases/GSA_references/GSA-24v3-0-A2-product_files/GSA-24v3-0_A2_extended.csv"
    
    // array parameters
    idat_path = null
    gtc_path = null

    // resource related parameters
    cluster_options = "--mail-user ${params.email} --mail-type FAIL --account=diaggen"

    // process related parameters
    call_rate_threshold = 0.97
    gatk_filter = "\
    --genotype-filter-expression 'isCalled == 0' --genotype-filter-name 'isCalledFilter' \
    --genotype-filter-expression 'IGC <= 0.15' --genotype-filter-name 'IlluminasGencallConfidenceFilter' \
    --genotype-filter-expression 'meanR_AA <= 0.2 || meanR_AB <= 0.2 || meanR_BB <= 0.2' --genotype-filter-name 'meanRFilter' "
    gatk_select = "--exclude-filtered --set-filtered-gt-to-nocall -select 'vc.getGenotype(0).isCalled()'"

}

process {
    withLabel: IAAP_CLI_1_1_0_GenCall {
        cpus = 2
        memory = '8G'
        time = '30m'
    }

    withLabel: PICARD_2_26_4_hdfd78af_0_GtcToVcf {
        cpus = 2
        memory = '8G'
        time = '30m'
        clusterOptions = "${params.cluster_options} --gres=tmpspace:10G"

        publishDir {
            path = "${params.outdir}/vcf_files/"
            mode = 'link'
        }
    }

    withLabel: BafRegress_0_9_3_BafRegress {
        cpus = 2
        memory = '4G'
        time = '30m'

        publishDir {
            path = "${params.outdir}/QC/contamination/"
            mode = 'link'
        }
    }

    withLabel: VERIFYIDINTENSITY_0_0_1_hc90279e_1_VerifyIDIntensity {
        cpus = 2
        memory = '4G'
        time = '30m'

        publishDir {
            path = "${params.outdir}/QC/contamination/"
            mode = 'link'
        }
    }

    withLabel: PICARD_2_26_4_hdfd78af_0_CreateVerifyIDIntensityContaminationMetricsFile {
        cpus = 2
        memory = '8G'
        time = '30m'

        publishDir {
            path = "${params.outdir}/QC/contamination/"
            mode = 'link'
        }
    }

    withLabel: PICARD_2_26_4_hdfd78af_0_VcfToAdpc {
        cpus = 2
        memory = '8G'
        time = '30m'
        clusterOptions = "${params.cluster_options} --gres=tmpspace:10G"

        publishDir {
            path = "${params.outdir}/adpc_files/"
            mode = 'link'
        }
    }

    withName: PICARD_VariantCallingMetrics {
        cpus = 2
        memory = '8G'
        time = '30m'
        clusterOptions = "${params.cluster_options} --gres=tmpspace:10G"

        publishDir {
            path = "${params.outdir}/QC/picard_variant_calling_metrics/"
            mode = 'link'
        }
    }

    withName: PICARD_VariantCallingMetrics_Intervals {
        cpus = 2
        memory = '8G'
        time = '30m'
        clusterOptions = "${params.cluster_options} --gres=tmpspace:10G"

        publishDir {
            path = "${params.outdir}/QC/picard_variant_calling_metrics/"
            mode = 'link'
        }
    }

    withLabel: GATK_4_2_0_0_SelectVariants {
        cpus = 2
        memory = '10G'
        time = '10m'

        publishDir {
            path = "$params.outdir/vcf_files_select/"
            mode = 'link'
        }
    }

    withLabel: GATK_4_2_0_0_VariantFiltration {
        cpus = 2
        memory = '10G'
        time = '10m'

        publishDir {
            path = "$params.outdir/vcf_files_filtered/"
            mode = 'link'
        }
    }

    withLabel: VariantGenotypeToPhenotype {
        cpus = 2
        memory = "4G"
        time = "30m"
        publishDir {
            path = "${params.outdir}/phenotypes/"
            mode = "link"
        }
    }

    withLabel: VersionLog {
        cpus = 2
        memory = '5G'
        time = '1h'

        publishDir {
            path = "${params.outdir}/log"
            mode = 'link'
        }
    }
}


profiles {
    mac {
        docker.enabled = true
        docker.runOptions = '-v /Users:/Users'
    }

    slurm {
        executor {
            queueSize = 1000
        }

        mail {
            smtp.host = 'localhost'
        }

        process {
            executor = 'slurm'
            queue = 'cpu'
            clusterOptions = "${params.cluster_options}"

            errorStrategy = 'retry'
            maxRetries = 3
        }

        singularity {
            enabled = true
            runOptions = '-B /hpc:/hpc -B $TMPDIR:$TMPDIR'
            autoMounts = true
            cacheDir = '/hpc/diaggen/software/singularity_cache'
        }
    } 
}

report {
    enabled = true
    file = "${params.outdir}/log/nextflow_report.html"
}

timeline {
    enabled = true
    file = "${params.outdir}/log/nextflow_timeline.html"
}

trace {
    enabled = true
    file = "${params.outdir}/log/nextflow_trace.txt"
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes,vol_ctxt,inv_ctxt'
}